{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy web:8080
}

# Открытие по http:// уводит на https://. Автоматический HTTPS Caddy обычно делает это сам,
# но явный блок гарантирует редирект при любых настройках и виден в конфиге.
http://{$DOMAIN} {
	redir https://{host}{uri} permanent
}
