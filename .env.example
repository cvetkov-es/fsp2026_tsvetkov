# Скопируйте в .env. Ключи не коммитятся.
DATABASE_URL=postgresql+psycopg://fsp:fsp@db:5432/fsp
SECRET_KEY=change-me
DEMO_MODE=true
PUBLIC_BASE_URL=http://localhost:8080
COOKIE_SECURE=false
LLM_PROFILE=dev
LLM_BASE_URL=https://polza.ai/api/v1
LLM_API_KEY=
# Переопределение моделей (по умолчанию — маршрут профиля, техдизайн §9):
# LLM_MODEL_PD=  LLM_MODEL_PD_FALLBACK=  LLM_MODEL_RUNTIME=
NER_ENABLED=true
MAIL_HOST=mailpit
MAIL_PORT=1025
# FSP ID: по умолчанию — встроенный мок {PUBLIC_BASE_URL}/mock/fsp (только при DEMO_MODE или MOCKS_ENABLED=true).
# Переход на настоящий Keycloak ФСП — только эти переменные (спецификация 5.4):
# FSP_ID_ISSUER=https://<FSP ID>/realms/fsp
# FSP_ID_CLIENT_ID=  FSP_ID_CLIENT_SECRET=
# FSP_API_URL=https://<API достижений ФСП>/api/v1
# MOCKS_ENABLED=false
